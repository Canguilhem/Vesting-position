{
  "name": "vesting-positions-web",
  "description": "Marketing MVP for Vesting Positions — React, Vite, framework-kit",
  "keywords": [
    "kit",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "vite"
  ],
  "create-solana-dapp": {
    "rename": {
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "src"
        ]
      }
    }
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "codegen": "codama run js",
    "codegen:watch": "codama run js --watch",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.7.0",
    "@solana-program/token": "^0.14.0",
    "@solana/client": "^1.0.0-rc.2",
    "@solana/compat": "^7.0.0",
    "@solana/kit": "^6.10.0",
    "@solana/program-client-core": "^6.10.0",
    "@solana/react-hooks": "^1.0.0-rc.3",
    "@solana/sysvars": "^7.0.0",
    "@tailwindcss/vite": "^4",
    "bn.js": "^5.2.4",
    "buffer": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.1",
    "@codama/renderers-js": "^2.3.0",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "codama": "^1.8.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6"
  }
}
